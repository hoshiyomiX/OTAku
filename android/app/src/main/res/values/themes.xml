<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Theme definitions for OTAku.
        Material Design 3 (Material You) with Suisei Blue (#00B0F0) as the
        default brand palette. The teal/green palette (Theme.OTAku) is retained
        as a legacy reference but is NO LONGER the default — applyDynamicTheme()
        always uses Theme.OTAku.Suisei as the base theme.
    -->

    <!-- Splash screen theme — shows OTAku icon on black background at launch.
         Uses AndroidX SplashScreen API (compatible back to API 23).
         The icon (ic_launcher_foreground) is displayed centered with
         the iconBackground color behind it in a circular mask.
         Splash duration is set to 2 seconds in MainActivity.kt.
         No branding text — icon alone provides splash identity. -->
    <style name="Theme.OTAku.Splash" parent="Theme.SplashScreen">
        <!-- Black background matching the launcher icon -->
        <item name="windowSplashScreenBackground">#000000</item>
        <!-- The icon shown during splash — uses the same foreground as the launcher icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <!-- Icon background color (circular mask behind the icon) -->
        <item name="windowSplashScreenIconBackgroundColor">#000000</item>
        <!-- Branding text removed — was glitched (A letter flipped, u cut off).
             The icon alone is sufficient for splash screen identity.
             See values-v31/themes.xml for API 31+ specific overrides. -->
        <!-- After splash, transition to the Suisei Blue base theme (default) -->
        <item name="postSplashScreenTheme">@style/Theme.OTAku.Suisei</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Base application theme (light)                                -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <style name="Theme.OTAku" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>

        <!-- Tertiary color -->
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>

        <!-- Error color -->
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>

        <!-- Background and surface -->
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>

        <!-- Outline -->
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_light_outlineVariant</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Text appearance -->
        <item name="android:textColorPrimary">@color/md_theme_light_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_light_onSurfaceVariant</item>

        <!-- Material components -->
        <item name="toolbarStyle">@style/Widget.OTAku.Toolbar</item>
        <item name="materialButtonStyle">@style/Widget.OTAku.Button</item>

        <!-- Toolbar icon tinting -->
        <item name="colorControlNormal">@color/md_theme_light_onSurface</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Suisei Blue fallback theme (light)                            -->
    <!--                                                               -->
    <!-- Used on Android 8.0-11 (API 26-30) when Material You is not    -->
    <!-- available, or when the user has explicitly disabled dynamic    -->
    <!-- color. Base color #00B0F0 (Hoshimachi Suisei signature blue).  -->
    <!-- T42 (MD3 Expressive): parent switched to the Expressive base    -->
    <!-- theme — brings the expressive component defaults (morphing      -->
    <!-- buttons, expressive alert dialog overlay, spring motion styles, -->
    <!-- expressive FAB/dialog color wiring) while keeping the Suisei    -->
    <!-- palette and every existing override intact.                     -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <style name="Theme.OTAku.Suisei" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="colorPrimary">@color/suisei_light_primary</item>
        <item name="colorOnPrimary">@color/suisei_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/suisei_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/suisei_light_onPrimaryContainer</item>

        <item name="colorSecondary">@color/suisei_light_secondary</item>
        <item name="colorOnSecondary">@color/suisei_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/suisei_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/suisei_light_onSecondaryContainer</item>

        <item name="colorTertiary">@color/suisei_light_tertiary</item>
        <item name="colorOnTertiary">@color/suisei_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/suisei_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/suisei_light_onTertiaryContainer</item>

        <item name="colorError">@color/suisei_light_error</item>
        <item name="colorOnError">@color/suisei_light_onError</item>
        <item name="colorErrorContainer">@color/suisei_light_errorContainer</item>
        <item name="colorOnErrorContainer">@color/suisei_light_onErrorContainer</item>

        <item name="android:colorBackground">@color/suisei_light_background</item>
        <item name="colorOnBackground">@color/suisei_light_onBackground</item>
        <item name="colorSurface">@color/suisei_light_surface</item>
        <item name="colorOnSurface">@color/suisei_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/suisei_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/suisei_light_onSurfaceVariant</item>

        <item name="colorOutline">@color/suisei_light_outline</item>
        <item name="colorOutlineVariant">@color/suisei_light_outlineVariant</item>

        <!-- Surface containers (T34 audit E1): dialog/menu/popup surfaces
             follow the Suisei palette on API 26-30 (DynamicColors covers 31+);
             without these they fell back to baseline M3 neutral gray. -->
        <item name="colorSurfaceContainerLowest">@color/suisei_light_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/suisei_light_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/suisei_light_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/suisei_light_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/suisei_light_surfaceContainerHighest</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:textColorPrimary">@color/suisei_light_onSurface</item>
        <item name="android:textColorSecondary">@color/suisei_light_onSurfaceVariant</item>

        <!-- Material components -->
        <item name="toolbarStyle">@style/Widget.OTAku.Toolbar</item>
        <item name="materialButtonStyle">@style/Widget.OTAku.Button</item>

        <!-- T42 (MD3 Expressive): dialogs ride the expressive overlay
             (bigger title panel, expressive dialog buttons) tuned to the
             MODERATE corner choice — 24dp instead of the expressive 28dp
             default — plus an emphasized-curve entrance animation. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.OTAku.MaterialAlertDialog</item>

        <!-- Toolbar icon tinting -->
        <item name="colorControlNormal">@color/suisei_light_onSurface</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Dark theme override                                           -->
    <!--                                                               -->
    <!-- THEME-DARK-FIX: Added missing component style overrides that   -->
    <!-- were present in Theme.OTAku (light) and Theme.OTAku.Suisei    -->
    <!-- but missing here. Without these, Theme.OTAku.Dark falls back  -->
    <!-- to default M3 styles, causing visual inconsistency (wrong      -->
    <!-- toolbar style, chip style, button corner radius, text colors)  -->
    <!-- when this theme is explicitly applied.                         -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <style name="Theme.OTAku.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="colorOnPrimary">@color/md_theme_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_dark_onPrimaryContainer</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/md_theme_dark_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_dark_onSecondaryContainer</item>

        <!-- Tertiary color -->
        <item name="colorTertiary">@color/md_theme_dark_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_dark_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_dark_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_dark_onTertiaryContainer</item>

        <!-- Error color -->
        <item name="colorError">@color/md_theme_dark_error</item>
        <item name="colorOnError">@color/md_theme_dark_onError</item>
        <item name="colorErrorContainer">@color/md_theme_dark_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_dark_onErrorContainer</item>

        <!-- Background and surface -->
        <item name="android:colorBackground">@color/md_theme_dark_background</item>
        <item name="colorOnBackground">@color/md_theme_dark_onBackground</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_dark_onSurfaceVariant</item>

        <!-- Outline -->
        <item name="colorOutline">@color/md_theme_dark_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_dark_outlineVariant</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Text appearance — was MISSING, caused fallback to M3 defaults -->
        <item name="android:textColorPrimary">@color/md_theme_dark_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_dark_onSurfaceVariant</item>

        <!-- Material components — was MISSING, caused wrong toolbar/chip/button styles -->
        <item name="toolbarStyle">@style/Widget.OTAku.Toolbar</item>
        <item name="materialButtonStyle">@style/Widget.OTAku.Button</item>

        <!-- Toolbar icon tinting -->
        <item name="colorControlNormal">@color/md_theme_dark_onSurface</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Custom component styles                                       -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- Toolbar style -->
    <!-- T34 audit E4: flat tonal M3 top app bar — colorSurfaceContainer
         container color (M3-2023 app bar spec), zero elevation (the old
         2dp shadow was an M2-ism; separation comes from the tonal step,
         which E1's container ramp now provides). -->
    <!-- T42: expressive top app bar typography — the title steps up to a
         TitleLarge-based 24sp/500 (MD3 Expressive favors larger, more
         present app bar titles). The Widget.Material3Expressive.Toolbar
         style itself is NOT public in the 1.14.0 AAR, so the typography
         override is applied on top of the M3 Surface base instead. -->
    <style name="Widget.OTAku.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="titleTextAppearance">@style/TextAppearance.OTAku.ToolbarTitle</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="subtitleTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:background">?attr/colorSurfaceContainer</item>
    </style>

    <!-- Primary button style -->
    <!-- T34 audit E3: cornerRadius 12dp -> 20dp — M3 canonical full-round
         pill for the 40dp-tall default button (Expressive favors rounder
         shapes; 12dp was the pre-M3 app standard). -->
    <!-- T42 (MD3 Expressive): re-parented onto Widget.Material3Expressive.Button
         — the shape is now the expressive shape-STATE-LIST (corners morph
         toward a full pill while pressed). The manual cornerRadius item is
         REMOVED on purpose: MaterialButton.cornerRadius would flatten the
         state-list back to a static shape and kill the morph. Label
         tweaks (caps/spacing/size) ride on top of the expressive label
         appearance and stay. -->
    <style name="Widget.OTAku.Button" parent="Widget.Material3Expressive.Button">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Tonal button variant (T34 audit E3 sibling) — T42: expressive
         parent + morphing shape (manual cornerRadius removed, see above). -->
    <style name="Widget.OTAku.Button.Tonal" parent="Widget.Material3Expressive.Button.TonalButton">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Outlined button variant (T34 audit E3 sibling) — T42: expressive
         parent + morphing shape (manual cornerRadius removed, see above). -->
    <style name="Widget.OTAku.Button.Outlined" parent="Widget.Material3Expressive.Button.OutlinedButton">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Text button variant — for inline/minimal buttons (no stroke, no fill).
         T34 audit E3: 24dp = full pill for the 48dp-tall log-header buttons
         (M3 text buttons are fully rounded; 24dp = half of the 48dp height).
         T42: expressive parent; its text style is a full pill at rest, so
         the manual cornerRadius became redundant and is dropped. -->
    <style name="Widget.OTAku.Button.Text" parent="Widget.Material3Expressive.Button.TextButton">
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- T42 — MD3 Expressive overlays & supporting styles            -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- Expressive alert dialogs, tuned to the MODERATE corner choice.
         Pattern is the documented Material dialog-shape override: setting
         shapeAppearance (+ nulling shapeAppearanceOverlay) on the dialog
         theme overlay wins over the library default (expressive 28dp).
         The emphasized entrance/exit animation rides on the same overlay
         via windowAnimationStyle. Applies to every MaterialAlertDialog:
         the progress pop-up (incl. its T41 completed-hold state), the
         cancel confirmation, and the payload build dialog. -->
    <style name="ThemeOverlay.OTAku.MaterialAlertDialog" parent="ThemeOverlay.Material3Expressive.MaterialAlertDialog">
        <!-- 1.14.0 channel: MaterialAlertDialog.Material3 resolves its shape
             through the @macro/m3_comp_dialog_container_shape token, which
             expands to ?attr/shapeAppearanceCornerExtraLarge — so overriding
             THAT theme attribute (not the generic shapeAppearance attr, which
             the alertDialogStyle chain shadows) is what reaches the dialog
             background MaterialShapeDrawable. -->
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.OTAku.MaterialAlertDialog</item>
        <item name="shapeAppearanceOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/Animation.OTAku.Dialog</item>
    </style>

    <!-- 24dp dialog corners (user's "moderat" pick: dialog 24dp vs the
         expressive default 28dp; cards already sit at 16dp in the layouts).
         parent="" is required — without an explicit parent AAPT resolves the
         implicit parent "ShapeAppearance.OTAku", which does not exist, and
         resource linking fails (CI Build #298). Mirrors the library's own
         pure corner styles (ShapeAppearance.Material3.Corner.* use parent=""). -->
    <style name="ShapeAppearance.OTAku.MaterialAlertDialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Dialog window animations on the MD3 emphasized curves (the mdc
         interpolator resources are not public, so the path data is defined
         locally — same MD3 spec paths). Enter: emphasized DECELERATE
         ("M 0.05 0.7 0.1 1"); exit: emphasized ACCELERATE
         ("M 0.3 0 0.8 0.15"). -->
    <style name="Animation.OTAku.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/ota_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/ota_dialog_exit</item>
    </style>

    <!-- Expressive top app bar title: TitleLarge stepped up to 24sp / weight
         500 (fontWeight resolves on API 28+; API 26-27 fall back to regular —
         graceful). Subtitle stays stock. -->
    <style name="TextAppearance.OTAku.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:fontWeight">500</item>
    </style>

    <!-- Log output text view style -->
    <!-- THEME-AWARE-FIX: Use ?attr/colorOnSurfaceVariant instead of hardcoded
         @color/log_text. The hardcoded color didn't follow the active theme
         (teal vs Suisei), causing visual mismatch during theme transitions.
         ?attr/colorOnSurfaceVariant provides muted but readable text that
         adapts to both light/dark mode and the active color palette. -->
    <style name="TextAppearance.OTAku.Log" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <!-- Section title style -->
    <!-- T42: TitleSmall -> TitleMedium — the MD3 Expressive type scale
         favors more present section headers (14sp -> 16sp, weight 500). -->
    <style name="TextAppearance.OTAku.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Body description text -->
    <style name="TextAppearance.OTAku.BodyDescription" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <!-- Helper/caption text (smaller, muted) -->
    <style name="TextAppearance.OTAku.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Micro caption — even smaller than Caption.
         Used for helperText that should look like mini-info hints
         (e.g. "Leave empty for auto-generated name").
         P0-fix: 9sp → 11sp (M3 LabelSmall minimum, T-01/C-05). -->
    <style name="TextAppearance.OTAku.Micro" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Label for form fields -->
    <style name="TextAppearance.OTAku.InputLabel" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
