<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Dark mode overrides for utility colors.
        Theme color attributes (colorSurface, etc.) are handled via
        values-night/themes.xml inheriting Theme.OTAku.Dark.
    -->

    <!-- Card borders -->
    <color name="card_border">#3F4944</color>

    <!-- Partition list text dark override (near-white on dark surface) -->
    <color name="partition_text">#E1E3E0</color>

    <!-- Log output dark theme overrides — dark bg + light text -->
    <color name="log_background">#1E1E1E</color>
    <color name="log_text">#D4D4D4</color>
    <color name="log_divider">#333333</color>

    <!-- DEPRECATED (MD3-FIX IMPL-001): log level colors now resolve from the
         ACTIVE theme's color tokens at runtime (?attr/colorPrimary etc.), which
         automatically provide proper dark-variant values. These static overrides
         are no longer referenced; kept for reference only. -->
    <color name="log_info">#A7E8DB</color>     <!-- bright teal — was #80CBC4 (too muted on dark) -->
    <color name="log_debug">#BDBDBD</color>    <!-- light gray — was #9E9E9E (too dark on dark) -->
</resources>
