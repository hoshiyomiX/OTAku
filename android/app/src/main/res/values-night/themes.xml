<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Night-mode override for Theme.OTAku.
        Same theme name, different parent and color palette.
        Android automatically picks values-night/ when night mode is active.
    -->
    <style name="Theme.OTAku" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="colorOnPrimary">@color/md_theme_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_dark_onPrimaryContainer</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/md_theme_dark_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_dark_onSecondaryContainer</item>

        <!-- Tertiary color -->
        <item name="colorTertiary">@color/md_theme_dark_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_dark_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_dark_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_dark_onTertiaryContainer</item>

        <!-- Error color -->
        <item name="colorError">@color/md_theme_dark_error</item>
        <item name="colorOnError">@color/md_theme_dark_onError</item>
        <item name="colorErrorContainer">@color/md_theme_dark_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_dark_onErrorContainer</item>

        <!-- Background and surface -->
        <item name="android:colorBackground">@color/md_theme_dark_background</item>
        <item name="colorOnBackground">@color/md_theme_dark_onBackground</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_dark_onSurfaceVariant</item>

        <!-- Outline -->
        <item name="colorOutline">@color/md_theme_dark_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_dark_outlineVariant</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Text appearance -->
        <item name="android:textColorPrimary">@color/md_theme_dark_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_dark_onSurfaceVariant</item>

        <!-- Material components -->
        <item name="toolbarStyle">@style/Widget.OTAku.Toolbar</item>
        <item name="materialButtonStyle">@style/Widget.OTAku.Button</item>

        <!-- Toolbar icon tinting -->
        <item name="colorControlNormal">@color/md_theme_dark_onSurface</item>
    </style>

    <!-- Suisei Blue dark theme override (Material You unavailable on API 26-30) -->
    <!-- T42 (MD3 Expressive): parent switched to the expressive dark base;
         same component defaults as the light theme (morphing buttons,
         expressive dialog overlay, spring motion styles); the moderate
         24dp dialog corner + emphasized entrance animation ride the
         shared OTAku overlay. -->
    <style name="Theme.OTAku.Suisei" parent="Theme.Material3Expressive.Dark.NoActionBar">
        <item name="colorPrimary">@color/suisei_dark_primary</item>
        <item name="colorOnPrimary">@color/suisei_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/suisei_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/suisei_dark_onPrimaryContainer</item>

        <item name="colorSecondary">@color/suisei_dark_secondary</item>
        <item name="colorOnSecondary">@color/suisei_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/suisei_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/suisei_dark_onSecondaryContainer</item>

        <item name="colorTertiary">@color/suisei_dark_tertiary</item>
        <item name="colorOnTertiary">@color/suisei_dark_onTertiary</item>
        <item name="colorTertiaryContainer">@color/suisei_dark_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/suisei_dark_onTertiaryContainer</item>

        <item name="colorError">@color/suisei_dark_error</item>
        <item name="colorOnError">@color/suisei_dark_onError</item>
        <item name="colorErrorContainer">@color/suisei_dark_errorContainer</item>
        <item name="colorOnErrorContainer">@color/suisei_dark_onErrorContainer</item>

        <item name="android:colorBackground">@color/suisei_dark_background</item>
        <item name="colorOnBackground">@color/suisei_dark_onBackground</item>
        <item name="colorSurface">@color/suisei_dark_surface</item>
        <item name="colorOnSurface">@color/suisei_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/suisei_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/suisei_dark_onSurfaceVariant</item>

        <item name="colorOutline">@color/suisei_dark_outline</item>
        <item name="colorOutlineVariant">@color/suisei_dark_outlineVariant</item>

        <!-- Surface containers (T34 audit E1): dialog/menu/popup surfaces
             follow the Suisei palette on API 26-30 (DynamicColors covers 31+);
             without these they fell back to baseline M3 neutral gray. -->
        <item name="colorSurfaceContainerLowest">@color/suisei_dark_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/suisei_dark_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/suisei_dark_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/suisei_dark_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/suisei_dark_surfaceContainerHighest</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:textColorPrimary">@color/suisei_dark_onSurface</item>
        <item name="android:textColorSecondary">@color/suisei_dark_onSurfaceVariant</item>

        <item name="toolbarStyle">@style/Widget.OTAku.Toolbar</item>
        <item name="materialButtonStyle">@style/Widget.OTAku.Button</item>

        <!-- T42 (MD3 Expressive): same dialog overlay as the light theme —
             expressive dialog defaults + moderate 24dp corners + emphasized
             entrance curve. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.OTAku.MaterialAlertDialog</item>

        <item name="colorControlNormal">@color/suisei_dark_onSurface</item>
    </style>
</resources>
