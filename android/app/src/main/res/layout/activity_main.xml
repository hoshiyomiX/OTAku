<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml — OTAku

    Single-purpose: Build partition images (.img) into flashable OTA ZIP.

    Layout (floating overlay architecture — T16):
    ┌────────────────────────────────────────┐
    │ TopAppBar (title + version + theme  │
    │   btn + overflow: Build OTA ZIP /   │
    │   Inspect / Build payload.bin)      │
    ├────────────────────────────────────────┤
    │ NestedScrollView (FULL height)      │
    │   Settings Card                     │
    │     Device / Partitions /           │
    │     Compression / Level / Output    │
    │   ProgressBar (per-partition bars)  │
    ├──────────────────────────────────────┤
    │ ~~ FLOATING Log Card (overlay) ~~   │
    │   gravity=bottom — morphable        │
    │   pill ↔ card, floats ABOVE the     │
    │   settings scroll (never in flow)   │
    │ + FAB "Build OTA Now" (bottom-end,  │
    │   shows when inputs are filled)     │
    └────────────────────────────────────────┘
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <!-- P2-fix L-02: removed android:fitsSystemWindows="true" (double-inset with root CoordinatorLayout) -->

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:subtitle="@string/toolbar_subtitle"
            app:titleTextColor="?attr/colorOnSurface"
            app:subtitleTextColor="?attr/colorOnSurfaceVariant"
                style="@style/Widget.OTAku.Toolbar" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Scrollable Settings — DIRECT child of the root        -->
    <!-- CoordinatorLayout (carries the appbar scrolling        -->
    <!-- behavior itself). The log card below is NOT in this    -->
    <!-- scroll flow: it is a true floating overlay             -->
    <!-- (gravity=bottom) stacked above this scroll view.       -->
    <!-- ═══════════════════════════════════════════════════ -->

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollViewSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="72dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            
            android:scrollbarSize="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <!-- ═══════════════════════════════════════ -->
                <!-- Unified Settings Card                    -->
                <!-- ═══════════════════════════════════════ -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- ── 0. Flashable Information ── -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/label_flashable_info"
                            style="@style/TextAppearance.OTAku.SectionTitle"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/description_flashable_info"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginBottom="4dp" />

                        <!-- ROM name + Maker (vertical stack) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="4dp">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/layoutRomName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_rom_name"
                                app:boxBackgroundColor="?attr/colorSurface"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                app:boxStrokeWidth="1dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editTextRomName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text"
                                    android:maxLines="1"
                                    android:gravity="center_vertical" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/layoutMaker"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_maker"
                                android:layout_marginTop="8dp"
                                app:boxBackgroundColor="?attr/colorSurface"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                app:boxStrokeWidth="1dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editTextMaker"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text"
                                    android:maxLines="1"
                                    android:gravity="center_vertical" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_optional_default_banner"
                            style="@style/TextAppearance.OTAku.Micro"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="4dp" />

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutlineVariant"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp" />

                        <!-- ── 1. Device ── -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_device"
                                style="@style/TextAppearance.OTAku.SectionTitle" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/description_device"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginBottom="8dp" />

                        <!--
                            Device codename input + Auto-Detect button (horizontal layout).
                            Input takes maximum width (weight=1), button has text + icon.
                            Original sizing restored — the icon-only button was too small
                            and hid the "Auto-Detect" label.
                        -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/layoutDevice"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/hint_device_codename"
                                android:layout_gravity="center_vertical"
                                app:boxBackgroundColor="?attr/colorSurface"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                app:boxStrokeWidth="1dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editTextDevice"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text"
                                    android:maxLines="1"
                                    android:gravity="center_vertical" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonAutoDetect"
                                style="@style/Widget.OTAku.Button.Tonal"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_gravity="center_vertical"
                                android:layout_marginStart="8dp"
                                android:text="@string/button_auto_detect"
                                android:tooltipText="@string/button_auto_detect"
                                android:minWidth="0dp"
                                android:paddingHorizontal="24dp"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_auto_detect"
                                app:iconSize="16dp"
                                app:iconGravity="textStart"
                                app:iconPadding="4dp" />

                        </LinearLayout>

                        <!-- Helper text below the input (smaller, uses Micro caption style) -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/helper_device_codename"
                            style="@style/TextAppearance.OTAku.Micro"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="4dp" />

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutlineVariant"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp" />

                        <!-- ── 2. Add Partitions ── -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_partitions"
                            style="@style/TextAppearance.OTAku.SectionTitle"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/textEmptyHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_add_images_prompt"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginBottom="8dp"
                            android:visibility="visible" />

                        <!-- Add Images + Remove All -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonAddImages"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="@string/button_add_images"
                                
                                android:minWidth="0dp"
                                android:paddingHorizontal="24dp"
                                style="@style/Widget.OTAku.Button.Tonal"
                                app:cornerRadius="12dp"
                                app:icon="@android:drawable/ic_input_add"
                                app:iconSize="16dp"
                                app:iconGravity="textStart"
                                app:iconPadding="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonRemoveAll"
                                style="@style/Widget.OTAku.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:text="@string/button_remove_all"
                                
                                android:minWidth="0dp"
                                android:paddingHorizontal="24dp"
                                app:cornerRadius="12dp"
                                android:visibility="gone"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <!-- Image list container (populated programmatically) -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="?attr/colorOutlineVariant"
                            app:cardBackgroundColor="?attr/colorSurface">

                            <LinearLayout
                                android:id="@+id/containerImageList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="8dp"
                                android:minHeight="48dp" />

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutlineVariant"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp" />

                        <!-- ── 3. Compression Format ── -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_compression"
                            style="@style/TextAppearance.OTAku.SectionTitle"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/description_compression"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginBottom="8dp" />

                        <!-- T19: AppCompatSpinner upgraded to the M3
                             ExposedDropdownMenu pattern (TextInputLayout +
                             MaterialAutoCompleteTextView) — same pattern as
                             the payload build dialog since T14. inputType=none
                             makes the field non-editable: the only reachable
                             values are the adapter items. The id keeps the
                             spinnerCompression name (now resolves to the
                             MaterialAutoCompleteTextView) to minimize churn. -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutCompression"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_compression_algorithm">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/spinnerCompression"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:maxLines="1"
                                android:gravity="center_vertical" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutlineVariant"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp" />

                        <!-- ── 4. Compression Level ── -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_compression_level"
                            style="@style/TextAppearance.OTAku.SectionTitle"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/description_compression_level"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginBottom="8dp" />

                        <!-- T19: AppCompatSpinner upgraded to the M3
                             ExposedDropdownMenu pattern — see the compression
                             algorithm selector above for the rationale. -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutCompressionLevel"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_compression_level">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/spinnerCompressionLevel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none"
                                android:maxLines="1"
                                android:gravity="center_vertical" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutlineVariant"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp" />

                        <!-- ── 5. Output ── -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_output"
                            style="@style/TextAppearance.OTAku.SectionTitle"
                            android:layout_marginBottom="4dp" />

                        <!-- Custom filename input -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutCustomFilename"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:hint="@string/hint_custom_filename"
                            app:boxBackgroundColor="?attr/colorSurface"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:helperText="@string/helper_custom_filename"
                            app:helperTextEnabled="true"
                            app:helperTextTextAppearance="@style/TextAppearance.OTAku.Micro"
                            app:counterEnabled="true"
                            app:counterMaxLength="128"
                            app:counterTextAppearance="@style/TextAppearance.OTAku.Micro">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editTextCustomFilename"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:maxLines="1"
                                android:gravity="center_vertical"
                                android:maxLength="128" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Output filename preview — italic filename, non-italic "Preview:" label -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp"
                            android:paddingStart="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_preview"
                                android:textSize="12sp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/textPreviewFilename"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textStyle="italic"
                                android:maxLines="2"
                                android:ellipsize="middle"
                                android:fontFamily="monospace" />

                        </LinearLayout>

                        <!-- Output directory + Browse -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="16dp">

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                app:boxBackgroundColor="?attr/colorSurface"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editTextOutput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/hint_output_dir"
                                    android:inputType="none"
                                    android:focusable="false"
                                    android:clickable="false"
                                    android:maxLines="2"
                                    android:ellipsize="middle"
                                    android:gravity="center_vertical" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonBrowseOutput"
                                style="@style/Widget.OTAku.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:text="@string/button_browse"
                                
                                android:minWidth="0dp"
                                android:paddingHorizontal="24dp"
                                app:cornerRadius="12dp"
                                app:icon="@android:drawable/ic_menu_view"
                                app:iconSize="16dp"
                                app:iconGravity="textStart"
                                app:iconPadding="4dp" />

                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutlineVariant"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp" />

                        <!-- Dynamic Color section REMOVED — color source is now
                             pure auto-detect (AUDIT-DC): Material You dynamic color
                             on API 31+ (applied by applyDynamicColorsOverlay() via
                             SuiseiColors.isDynamicColorAvailable), Suisei Blue brand
                             palette on API < 31. No user-facing toggle. -->

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- Progress Bar (per-partition bars while building)        -->
                <!-- ═══════════════════════════════════════════════════ -->

                <!-- Per-partition progress bars + labels (built programmatically) -->
                <LinearLayout
                    android:id="@+id/progressBarContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- Floating Log Panel — TRUE overlay (T16)                -->
        <!--                                                       -->
        <!-- Direct child of the root CoordinatorLayout with        -->
        <!-- gravity=bottom — NOT part of the settings scroll       -->
        <!-- flow; it floats ABOVE the full-height NestedScroll.    -->
        <!-- Expanded height = overlay share (~50% of the scroll    -->
        <!-- area), set programmatically by the container-morph     -->
        <!-- code. The scroll's bottom padding mirrors the card     -->
        <!-- height so its last row stays reachable.                -->
        <!-- ═══════════════════════════════════════════════════ -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/logCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorPrimaryContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Log header bar — clickable + swipeable to toggle expand/collapse.
                     T18: paddingVertical 4dp keeps the collapsed pill at 56dp
                     (48dp arrow + 2×4dp) — exact M3 parity with the 56dp
                     Build FAB across from it. Was 10dp → 68dp pill that
                     visually dwarfed the FAB. -->
                <LinearLayout
                    android:id="@+id/logHeaderBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <!-- Arrow toggle — LEFT of "Logs" text.
                         Plain ImageView with ?attr/colorPrimary tint for accent color.
                         Click handled by parent logHeaderBar (full-width clickable).
                         P0-fix A-02: 32dp → 48dp (M3 touch target minimum) -->
                    <ImageView
                        android:id="@+id/buttonToggleLog"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_expand_log"
                        android:contentDescription="@string/cd_arrow_expand_log"
                        android:clickable="true"
                        android:focusable="true"
                        android:tooltipText="@string/cd_toggle_log_panel"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="?attr/colorPrimary"
                        android:scaleType="centerInside"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_output_log"
                        android:textSize="12sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:textColor="?attr/colorPrimary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonCopyLog"
                        style="@style/Widget.OTAku.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/button_copy_log"
                        
                        android:minWidth="0dp"
                        android:paddingHorizontal="24dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonClearLog"
                        style="@style/Widget.OTAku.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/button_clear_log"
                        
                        android:minWidth="0dp"
                        android:layout_marginStart="4dp"
                        android:paddingHorizontal="24dp" />

                </LinearLayout>

                <!-- Log divider — uses theme attribute for consistent appearance
                     across teal/Suisei/dynamic themes (THEME-AWARE-FIX) -->
                <View
                    android:id="@+id/logDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- Standalone scrollable log — visibility toggled by header click.
                     When collapsed (GONE), the log card shrinks to just the header bar,
                     giving the settings NestedScrollView more space. -->
                <!-- IMPL-002 (BUG-02 fix): Use NestedScrollView instead of plain
                     ScrollView for proper nested scrolling coordination with the
                     settings NestedScrollView above. Without this, scrolling the
                     log panel and settings panel simultaneously can cause jitter
                     or missed scroll events on the outer layout. -->
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/scrollViewLog"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false"
                    android:scrollbarSize="6dp">

                    <TextView
                        android:id="@+id/textViewLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:textColor="?attr/colorPrimary"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:lineSpacingMultiplier="1.4"
                        android:typeface="monospace"
                        android:textIsSelectable="true" />

                </androidx.core.widget.NestedScrollView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- Floating Build FAB — bottom-END, across the log pill  -->
        <!-- (bottom-START). Persistent overlay (no scroll-away    -->
        <!-- behavior — parity with the log pill): PERMANENTLY in   -->
        <!-- the layout (T19) — renders DISABLED until the build    -->
        <!-- inputs are ready: images loaded + codename set, none   -->
        <!-- still loading, nothing executing. Gating is by         -->
        <!-- isEnabled via updateBuildFab() in MainActivity; the    -->
        <!-- M3 disabled colors come from the style's state-enabled -->
        <!-- selectors (visibility toggling never rendered after    -->
        <!-- the first layout pass on the target device).           -->
        <!-- T18: explicit 56dp height (M3 Extended FAB canonical   -->
        <!-- size — deterministic regardless of style resolution).  -->
        <!-- ═══════════════════════════════════════════════════ -->

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabBuild"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:enabled="false"
            android:text="@string/button_build_now"
            android:contentDescription="@string/button_build_now"
            app:icon="@drawable/ic_play"
            app:cornerRadius="16dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
