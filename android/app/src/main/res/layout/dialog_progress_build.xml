<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_progress_build.xml — OTAku

    Progress pop-up (T29): replaces the inline per-partition split progress
    bars (progressBarContainer) that used to sit under the settings card.
    Shown while a long-running operation is active — DD OTA build, payload
    build, or payload extract — and mirrors exactly what the foreground
    notification shows: the (message, percent) pairs funneled through
    showProgressNotification(), fed by the same .progress sidecar polling.

    MD3 CircularProgressIndicator (determinate) — the migration target of
    the old LinearProgressIndicator split row. Style + attrs verified
    against the material AAR (wave attrs verified against 1.14.0
    public.txt). Indicator + track follow the ACTIVE theme palette via
    ?attr (Material You on API 31+, Suisei Blue below).

    T42 (MD3 Expressive): the ring is now WAVY — the signature Expressive
    progress look. Activated through the public waveAmplitude/wavelength
    attrs on the stock indicator style (the .Wavy styles are not public
    API in 1.14.0, but amplitude > 0 IS the activation mechanism). The
    values scale the library's own defaults (1.6dp amplitude / 15dp
    wavelength at the 48dp with-wave size) proportionally to this 96dp
    ring: amplitude 4dp / wavelength 30dp. Wave reach at 4dp leaves
    ~10dp clearance to the T41 checkmark glyph inside the ring — the
    completed state still reads as one coherent glyph.

    Cancel support (T36): the dialog offers "Hide" (dismisses the VIEW only
    — the operation keeps running, tracked by the notification and the log
    card) and a red "Cancel" button that REALLY aborts the running Rust
    operation at its next 4MB chunk checkpoint (with a confirmation step —
    see MainActivity.requestCancelWithConfirm). Back-gesture/outside-tap
    dismissal stays disabled so the progress surface is never lost by
    accident. The window blurs the main UI behind it on API 31+ via
    FLAG_BLUR_BEHIND and deepens the dim below 31 (Suisei fallback
    convention).

    Completed state (T41): when the operation ends, the pop-up is NOT torn
    down — it is held open showing the final result: on success the ring
    snaps to 100% with a colorPrimary checkmark centered inside it and the
    button pair collapses to a single "Close"; on cancellation/failure the
    status line carries the outcome instead (no checkmark, ring stays at
    its last percent). See MainActivity.holdBuildProgressDialogForResult.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">
    <!-- T34 audit E5: was 8dp horizontal / 8dp vertical — the custom view
         sits in the dialog's custom panel with NO automatic insets, so the
         indicator column landed ~16dp off the title's 24dp grid and nearly
         edge-to-edge with the dialog surface. 24dp horizontal = M3
         dialogPreferredPadding (aligned with the builder title + button
         row); 16dp vertical keeps the round indicator breathing room
         (Expressive favors generous whitespace). -->

    <!-- T41: FrameLayout centers the success checkmark INSIDE the ring —
         "checkmark in the middle of the progress bar". The frame sizes to
         the 96dp indicator (wrap_content); the 48dp glyph centers against
         it with ~14dp clearance inside the 10dp track, matching the icon
         grid of the other dialog elements. -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressDialogCircular"
            style="@style/Widget.Material3.CircularProgressIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:max="100"
            android:contentDescription="@string/cd_progress_overall"
            app:indicatorSize="96dp"
            app:trackThickness="10dp"
            app:trackCornerRadius="5dp"
            app:waveAmplitude="4dp"
            app:wavelength="30dp"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="?attr/colorSurfaceVariant"
            tools:progress="43" />

        <!-- T41: gone while the operation runs; VISIBLE only in the
             completed-hold state (success path only — cancelled/failed
             endings keep the bare ring at its last percent). -->
        <ImageView
            android:id="@+id/progressDialogCheckIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_progress_check"
            android:contentDescription="@string/cd_progress_done"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

    <TextView
        android:id="@+id/progressDialogPercentText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAppearance="?attr/textAppearanceHeadlineLarge"
        android:textColor="?attr/colorOnSurface"
        android:maxLines="1"
        tools:text="43%" />

    <TextView
        android:id="@+id/progressDialogStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_horizontal"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="Compressing system (2/7) — 43%" />

</LinearLayout>
