<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/action_toggle_theme"
        android:title="@string/theme_label"
        android:icon="@drawable/ic_theme_auto"
        android:contentDescription="@string/theme_label"
        app:showAsAction="always"
        app:tint="?attr/colorOnSurface" />

    <!-- Payload.bin inspector (prototype) — overflow item keeps the MD3
         toolbar surface minimal: one always-shown action (theme) only. -->
    <item
        android:id="@+id/action_inspect_payload"
        android:title="@string/menu_inspect_payload"
        app:showAsAction="never" />

    <!-- Payload.bin builder (prototype) — overflow item next to the
         inspector; packs the loaded partition images into payload.bin. -->
    <item
        android:id="@+id/action_build_payload"
        android:title="@string/menu_build_payload"
        app:showAsAction="never" />

</menu>
